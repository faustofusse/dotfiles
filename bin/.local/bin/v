#!/usr/bin/env bash

required_tools=(nvim realpath)
missing=()

for tool in "${required_tools[@]}"; do
    if ! command -v "$tool" &> /dev/null; then
        missing+=("$tool")
    fi
done

if [ "${#missing[@]}" -ne 0 ]; then
    echo "$0: error: missing required tools: ${missing[*]}" >&2
    exit 1
fi

# Detect if inside neovim. NVIM is current, NVIM_LISTEN_ADDRESS is legacy.
NVIM_SERVER="${NVIM:-$NVIM_LISTEN_ADDRESS}"

if [ -n "$NVIM_SERVER" ]; then
    if [ ! -S "$NVIM_SERVER" ]; then
        echo "v: error: NVIM server socket does not exist: $NVIM_SERVER" >&2
        exit 1
    fi

    # inside neovim: parse args and send files/commands to parent
    commands=()
    paths=()

    i=1
    while [ $i -le $# ]; do
        arg="${!i}"
        if [ "$arg" = "-c" ]; then
            i=$((i + 1))
            if [ $i -gt $# ]; then
                echo "v: error: -c requires an argument" >&2
                exit 1
            fi
            commands+=("${!i}")
        elif [[ "$arg" == +* ]]; then
            commands+=("${arg:1}")
        elif [[ "$arg" == -* ]]; then
            echo "v: error: unsupported flag inside nvim: $arg" >&2
            exit 1
        else
            abs_path=$(realpath "$arg" 2>/dev/null)
            if [ $? -ne 0 ] || [ -z "$abs_path" ]; then
                echo "v: error: invalid path: $arg" >&2
                exit 1
            fi
            paths+=("$abs_path")
        fi
        i=$((i + 1))
    done

    # Open paths first so commands operate on them
    for p in "${paths[@]}"; do
        nvim --server "$NVIM_SERVER" --remote "$p"
    done

    # Send commands to parent (skip quit commands — they close the picker/window)
    for raw_cmd in "${commands[@]}"; do
        cmd="$raw_cmd"
        cmd="${cmd#+}"  # normalize +q → q, +qa → qa, etc.

        case "$cmd" in
            q|qa|quit|wq|x|exit|qa!|q!|wq!|x!)
                continue
                ;;
        esac
        # <C-\><C-n> forces normal mode in case parent is in terminal insert mode
        nvim --server "$NVIM_SERVER" --remote-send "<C-\><C-n>:$cmd<CR>"
    done

    exit
fi

# outside neovim

# Find the directory to check for a develop flake
target_dir=""
for arg in "$@"; do
    if [[ "$arg" != -* ]]; then
        if [ -d "$arg" ]; then
            target_dir="$arg"
        elif [ -e "$arg" ]; then
            target_dir=$(dirname "$arg")
        else
            target_dir=$(dirname "$arg" 2>/dev/null || echo "$PWD")
        fi
        break
    fi
done
[ -z "$target_dir" ] && target_dir="$PWD"

# Resolve to absolute path
target_dir=$(cd "$target_dir" 2>/dev/null && pwd || echo "$target_dir")

# Walk up the tree looking for flake.nix
flake_dir="$target_dir"
while [ -n "$flake_dir" ] && [ "$flake_dir" != "/" ]; do
    if [ -f "$flake_dir/flake.nix" ]; then
        break
    fi
    flake_dir=$(dirname "$flake_dir")
done

# Launch nvim inside the flake's devShell if one was found
if [ -n "$flake_dir" ] && [ -f "$flake_dir/flake.nix" ] && command -v nix &> /dev/null; then
    # nix develop overrides the SHELL env var to bash; force nvim's shell option
    # explicitly so :terminal uses the user's preferred shell.
    user_shell="${SHELL:-$(command -v zsh 2>/dev/null || command -v bash 2>/dev/null || echo /bin/sh)}"
    nix develop "$flake_dir" -c nvim --cmd "set shell=$user_shell" "$@"
else
    nvim "$@"
fi
