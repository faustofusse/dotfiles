#!/usr/bin/env bash

required_tools=(nvim realpath)
missing=()

for tool in "${required_tools[@]}"; do
    if ! command -v "$tool" &> /dev/null; then
        missing+=("$tool")
    fi
done

if [ "${#missing[@]}" -ne 0 ]; then
    echo "$0: error: missing required tools: ${missing[*]}" >&2
    exit 1
fi

if [ -n "$NVIM" ]; then
    # inside neovim
    for arg in "$@"; do
        abs_path=$(realpath "$arg")
        nvim --server "$NVIM" --remote "$abs_path"
    done
    exit
fi

# outside neovim

nvim "$@"
